{
  "name": "buddypoke-studio",
  "private": true,
  "version": "0.0.1",
  "description": "BuddyPoke 3D Character Studio, built on the original BuddyRevival decoder.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:engine && npm run test:unit",
    "test:engine": "node ../tests/engine.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/smoke.mjs && node tests/e2e/render.mjs && node tests/e2e/viewport.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
